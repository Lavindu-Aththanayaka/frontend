# In local dev (each service on its own port)
NEXT_PUBLIC_CATALOG_API=http://localhost:8080
NEXT_PUBLIC_ORDER_API=http://localhost:8082

# In Kubernetes, once ingress is set up, these become path-based routes
# through Nginx instead of raw ports, e.g.:
# NEXT_PUBLIC_CATALOG_API=/api/catalog
# NEXT_PUBLIC_ORDER_API=/api/orders
